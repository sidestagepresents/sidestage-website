{% macro card(e) %}
<article class="event{% if not e.data.image %} no-img{% endif %}">
  {% if e.data.image %}
  <div class="event-img">{% eventImage e.data.image, e.data.artist + " flyer" %}</div>
  {% endif %}
  <div class="event-body">
    <h2>{{ e.data.artist }}{% if e.data.title %}<span class="event-title"> — {{ e.data.title }}</span>{% endif %}</h2>
    <p class="meta">{{ e.data.date | readableDate }} · {{ e.data.venue }}, {{ e.data.city }}</p>
    <p class="actions">
      {% if e.data.sold_out %}<span class="badge">SOLD OUT</span>
      {% elif e.data.ticket_link %}<a class="btn" href="{{ e.data.ticket_link | utm }}" target="_blank" rel="noopener">Tickets</a>{% endif %}
    </p>
  </div>
</article>
{% endmacro %}
