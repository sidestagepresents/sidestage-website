<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = title or name or settings.seo_title %}
{% set pageDesc = description or settings.seo_description %}
{% set shareImage = image or settings.og_image %}
<title>{% if title or name %}{{ pageTitle }} — {% endif %}{{ settings.site_name }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta property="og:site_name" content="{{ settings.site_name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ settings.site_url }}{{ page.url }}">
{% if shareImage %}<meta property="og:image" content="{{ settings.site_url }}{{ shareImage }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
{% if shareImage %}<meta name="twitter:image" content="{{ settings.site_url }}{{ shareImage }}">{% endif %}
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
{% set aboutPage = collections.all | selectattr("fileSlug", "equalto", "about") | first %}
{% set showAbout = aboutPage and not aboutPage.data.draft and aboutPage.data.show_in_nav != false %}
<div class="wrap">
<header>
  <a class="wordmark" href="/" aria-label="{{ settings.site_name }} — home"><img class="logo" src="/img/logo.png" alt="{{ settings.site_name }}"></a>
  <nav>
    <a href="/">Upcoming</a>
    <a href="/archive/">Archive</a>
    <a href="/artists/">Artists</a>
    {% if showAbout %}<a href="/about/">About</a>{% endif %}
    {% if settings.instagram_url %}<a class="icon-btn" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>{% endif %}
  </nav>
</header>
<main>
{{ content | safe }}
</main>
<footer>
  {% if settings.instagram_url %}<p><a class="btn" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Follow on Instagram</a></p>{% endif %}
  <p>{{ settings.seo_description }}</p>
  <p>
    {% if showAbout %}<a href="/about/">About</a> ·{% endif %}
    <a href="/privacy/">Privacy</a>{% if settings.instagram_url %} ·
    <a href="{{ settings.instagram_url }}">Instagram</a>{% endif %}{% if settings.facebook_url %} ·
    <a href="{{ settings.facebook_url }}">Facebook</a>{% endif %}{% if settings.x_url %} ·
    <a href="{{ settings.x_url }}">X</a>{% endif %}{% if settings.tiktok_url %} ·
    <a href="{{ settings.tiktok_url }}">TikTok</a>{% endif %}{% if settings.youtube_url %} ·
    <a href="{{ settings.youtube_url }}">YouTube</a>{% endif %}
  </p>
</footer>
</div>
</body>
</html>
