<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = title or name or settings.seo_title %}
{% set pageDesc = description or settings.seo_description %}
{% set shareImage = image or settings.og_image %}
<title>{% if title or name %}{{ pageTitle }} — {% endif %}{{ settings.site_name }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta property="og:site_name" content="{{ settings.site_name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ settings.site_url }}{{ page.url }}">
{% if shareImage %}<meta property="og:image" content="{{ settings.site_url }}{{ shareImage }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
{% if shareImage %}<meta name="twitter:image" content="{{ settings.site_url }}{{ shareImage }}">{% endif %}
<link rel="stylesheet" href="/css/style.css?v=2">
</head>
<body>
{% set aboutPage = collections.all | selectattr("fileSlug", "equalto", "about") | first %}
{% set showAbout = aboutPage and not aboutPage.data.draft and menu.show_about != false %}
{% set showPrivacy = menu.show_privacy != false %}
<div class="wrap">
<header>
  <a class="wordmark" href="/" aria-label="{{ settings.site_name }} — home"><img class="logo" src="/img/logo.png" alt="{{ settings.site_name }}"></a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" tabindex="-1" aria-hidden="true">
  <label for="nav-toggle" class="nav-burger" aria-label="Menu"><span></span><span></span><span></span></label>
  <nav>
    {% if menu.show_upcoming != false %}<a href="/">Upcoming</a>{% endif %}
    {% if menu.show_archive != false %}<a href="/archive/">Archive</a>{% endif %}
    {% if menu.show_artists != false %}<a href="/artists/">Artists</a>{% endif %}
    {% if showAbout %}<a href="/about/">About</a>{% endif %}
    {% if menu.show_instagram != false and settings.instagram_url %}<a class="icon-btn" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>{% endif %}
    {% if menu.show_cta and menu.cta_text and menu.cta_url %}<a class="btn btn-sm nav-cta" href="{{ menu.cta_url }}" target="_blank" rel="noopener">{{ menu.cta_text }}</a>{% endif %}
  </nav>
</header>
<main>
{{ content | safe }}
</main>
<footer>
  {% if settings.instagram_url %}<p><a class="btn" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Follow on Instagram</a></p>{% endif %}
  <p>{{ settings.seo_description }}</p>
  {% set hasSocials = settings.instagram_url or settings.facebook_url or settings.x_url or settings.tiktok_url or settings.youtube_url %}
  <p>
    {% if showAbout %}<a href="/about/">About</a>{% if showPrivacy or hasSocials %} ·{% endif %}{% endif %}
    {% if showPrivacy %}<a href="/privacy/">Privacy</a>{% if hasSocials %} ·{% endif %}{% endif %}
    {% if settings.instagram_url %}<a href="{{ settings.instagram_url }}">Instagram</a>{% if settings.facebook_url or settings.x_url or settings.tiktok_url or settings.youtube_url %} ·{% endif %}{% endif %}
    {% if settings.facebook_url %}<a href="{{ settings.facebook_url }}">Facebook</a>{% if settings.x_url or settings.tiktok_url or settings.youtube_url %} ·{% endif %}{% endif %}
    {% if settings.x_url %}<a href="{{ settings.x_url }}">X</a>{% if settings.tiktok_url or settings.youtube_url %} ·{% endif %}{% endif %}
    {% if settings.tiktok_url %}<a href="{{ settings.tiktok_url }}">TikTok</a>{% if settings.youtube_url %} ·{% endif %}{% endif %}
    {% if settings.youtube_url %}<a href="{{ settings.youtube_url }}">YouTube</a>{% endif %}
  </p>
</footer>
</div>
</body>
</html>
